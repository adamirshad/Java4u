<Application x:Class="Java4u.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#10130F" />
    <SolidColorBrush x:Key="PanelBg" Color="#191E18" />
    <SolidColorBrush x:Key="PanelBorder" Color="#30382D" />
    <SolidColorBrush x:Key="MutedText" Color="#929B8B" />
    <SolidColorBrush x:Key="Accent" Color="#C5F580" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E8EDE2" />
      <Setter Property="Background" Value="#242C20" />
      <Setter Property="BorderBrush" Value="#394533" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#303B2A" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EEF1E9" />
      <Setter Property="Background" Value="#111510" />
      <Setter Property="BorderBrush" Value="#3A4435" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Resources>
</Application>
