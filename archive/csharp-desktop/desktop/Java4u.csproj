<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Java4u</AssemblyName>
    <RootNamespace>Java4u</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\chunky\build\libs\chunky-loader.jar" Link="chunky\chunky-loader.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildChunkyRuntime" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\chunky\build.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\..\chunky\build\libs\chunky-loader.jar&quot;" />
  </Target>
</Project>
