<Window x:Class="Java4u.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Java4u" Height="790" Width="1240" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}" Foreground="#EEF1E9">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" BorderBrush="#252B23" BorderThickness="0,0,1,0" Background="#121510">
      <DockPanel Margin="18,22">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="5,2,0,42">
            <UniformGrid Columns="2" Rows="2" Width="25" Height="25" Margin="0,0,10,0">
              <Border Background="#C5F580" CornerRadius="2" Margin="0,0,2,2"/><Border Background="#A7D96A" CornerRadius="2" Margin="0,0,0,2"/>
              <Border Background="#8FBD5D" CornerRadius="2" Margin="0,0,2,0"/><Border Background="#B4E875" CornerRadius="2"/>
            </UniformGrid>
            <TextBlock Text="Java4u" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="." FontSize="25" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="LIBRARY" Foreground="{StaticResource MutedText}" FontSize="10" Margin="10,0,0,10" />
          <Border Background="#252D21" CornerRadius="6" Padding="11,10" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="17" Width="25" Foreground="{StaticResource Accent}"/><TextBlock Text="Home" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></StackPanel></Border>
          <Button Content="▦   Instances" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="11,10" Click="InstancesButton_Click" />
          <Button Content="✳   Mod browser" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="11,10" Click="ModsButton_Click" />
          <TextBlock Text="TOOLS" Foreground="{StaticResource MutedText}" FontSize="10" Margin="10,29,0,10" />
          <Button Content="↓   Downloads" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="11,10" Click="DownloadsButton_Click" />
          <Button x:Name="SettingsButton" Content="⚙   Settings" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="11,10" Click="SettingsButton_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,2">
          <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Background="{StaticResource PanelBg}" CornerRadius="7" Padding="10" Margin="0,0,0,14">
            <StackPanel><TextBlock Text="MICROSOFT ACCOUNT" FontSize="9" Foreground="{StaticResource MutedText}"/><Button x:Name="AccountButton" Content="Sign in with Microsoft" HorizontalContentAlignment="Left" Padding="0,5,0,0" Background="Transparent" BorderThickness="0" FontSize="12" Click="AccountButton_Click"/><Button x:Name="CancelAuthButton" Content="Cancel sign-in" HorizontalContentAlignment="Left" Padding="0,5,0,0" Background="Transparent" BorderThickness="0" FontSize="11" Visibility="Collapsed" Click="CancelAuthButton_Click"/></StackPanel>
          </Border>
          <TextBlock FontSize="9" Foreground="{StaticResource MutedText}"><Run Text="●  READY FOR SETUP"/><Run Text="     v0.5.0"/></TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="42,0,42,0">
      <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="#252B23" BorderThickness="0,0,0,1">
        <DockPanel><TextBlock Text="LIBRARY   /   HOME" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="?   Help" Background="Transparent" BorderThickness="0" Click="HelpButton_Click"/></DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="0,28,0,19">
        <StackPanel><TextBlock Text="YOUR GAME, YOUR WAY" FontFamily="Consolas" FontSize="10" Foreground="#A4AE99"/><TextBlock Text="Good to see you." FontSize="32" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="Set up an instance, then Java4u will keep it organized for you." Foreground="{StaticResource MutedText}" FontSize="13"/></StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Background="{StaticResource PanelBg}" CornerRadius="5" Padding="10,7"><TextBlock Text="●  LOCAL LIBRARY" Foreground="#B6C2AB" FontFamily="Consolas" FontSize="10"/></Border>
      </Grid>
      <Border Grid.Row="2" CornerRadius="9" BorderBrush="#38432F" BorderThickness="1" ClipToBounds="True">
        <Grid>
          <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#29392A" Offset="0"/><GradientStop Color="#4A5A39" Offset="0.55"/><GradientStop Color="#252E24" Offset="1"/></LinearGradientBrush></Grid.Background>
          <Canvas Opacity="0.55">
            <Ellipse Width="120" Height="120" Fill="#E0D08C" Canvas.Right="150" Canvas.Top="22"/>
            <Polygon Points="0,210 310,65 560,210" Fill="#53684F" Canvas.Right="-40" Canvas.Bottom="48"/>
            <Polygon Points="0,220 275,100 570,220" Fill="#374735" Canvas.Right="-30" Canvas.Bottom="35"/>
            <Rectangle Width="900" Height="52" Fill="#2C3829" Canvas.Bottom="0" Canvas.Right="0"/>
          </Canvas>
          <Border Background="#D910140F" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,0,0,0">
            <TextBlock Text="JAVA4U · YOUR NEXT WORLD" FontFamily="Consolas" FontSize="10" Foreground="#CBD5C0"/>
            <TextBlock Text="Your worlds,\nyour setup." FontSize="36" FontWeight="SemiBold" LineHeight="39" Margin="0,15,0,8"/>
            <TextBlock Text="Create an instance to get started with Chunky." FontSize="12" Foreground="#C1C8BB"/>
            <Button Content="＋  New instance" HorizontalAlignment="Left" Background="{StaticResource Accent}" Foreground="#172011" BorderThickness="0" FontWeight="SemiBold" Margin="0,19,0,0" Click="NewInstanceButton_Click"/>
          </StackPanel>
          <TextBlock Text="CHUNKY LOADER  ·  EARLY COMPATIBILITY ALPHA" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18" FontFamily="Consolas" FontSize="9" Foreground="#E5EBDC"/>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="0,24,0,12">
        <StackPanel><TextBlock Text="YOUR SETUPS" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource MutedText}"/><TextBlock Text="Instances" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
        <Button Content="＋  New instance" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="12,7" Click="NewInstanceButton_Click"/>
      </Grid>
      <Grid Grid.Row="4">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox x:Name="InstanceList" Grid.Row="0" Background="Transparent" BorderThickness="0" Foreground="#EEF1E9" SelectionChanged="InstanceList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="240" Margin="0,0,12,12" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Background="{StaticResource PanelBg}" CornerRadius="7" Padding="13">
                <StackPanel>
                  <Border Height="87" CornerRadius="4" Background="#334532" Margin="0,0,0,11"><Grid><Ellipse Width="29" Height="29" Fill="#DCCF8F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,22,0"/><Polygon Points="0,87 91,28 170,87" Fill="#526A4C"/><Polygon Points="80,87 173,37 240,87" Fill="#344A39"/><Border Background="#111712C9" CornerRadius="3" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7"><TextBlock Text="{Binding MinecraftVersion}" FontFamily="Consolas" FontSize="9"/></Border></Grid></Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Margin="0,7,0,0" FontSize="10" Foreground="{StaticResource MutedText}"><Run Text="{Binding Loader}"/><Run Text="   ·   MC "/><Run Text="{Binding MinecraftVersion}"/><Run Text="   ·   "/><Run Text="{Binding MemoryLimitGb}"/><Run Text=" GB"/></TextBlock>
                  <TextBlock Margin="0,6,0,0" FontSize="9" Foreground="#A6C988" Text="Game files installed"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#273222"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20271D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel x:Name="EmptyState" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="No instances yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="Create a profile to define a Minecraft version and loader." FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
          <Button Content="Create your first instance" HorizontalAlignment="Center" Margin="0,14,0,0" Click="NewInstanceButton_Click"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,8,0,2">
          <StackPanel><TextBlock Text="INSTANCE FOLDER" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource MutedText}"/><TextBlock x:Name="SelectedInstancePath" Text="Select an instance to see its folder." FontSize="9" Foreground="#AAB3A2" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <TextBlock x:Name="InstanceCount" DockPanel.Dock="Right" Text="0 INSTANCES" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="2" Margin="0,8,0,2">
          <TextBlock x:Name="OperationStatus" Text="Ready" Foreground="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="LaunchButton" Content="▶  Launch" Background="{StaticResource Accent}" Foreground="#172011" BorderThickness="0" FontWeight="SemiBold" IsEnabled="False" Click="LaunchButton_Click"/><Button x:Name="InstallButton" Content="↓  Install game files" Margin="8,0,0,0" IsEnabled="False" Click="InstallButton_Click"/><Button x:Name="CancelInstallButton" Content="Cancel install" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelInstallButton_Click"/><Button x:Name="InspectModsButton" Content="Inspect mods" Margin="8,0,0,0" IsEnabled="False" Click="InspectModsButton_Click"/><Button x:Name="OpenFolderButton" Content="Open folder" Margin="8,0,0,0" IsEnabled="False" Click="OpenFolderButton_Click"/><Button x:Name="CheckJavaButton" Content="Check Java" Margin="8,0,0,0" IsEnabled="False" Click="CheckJavaButton_Click"/><Button x:Name="EditButton" Content="Edit settings" Margin="8,0,0,0" IsEnabled="False" Click="EditButton_Click"/><Button x:Name="DeleteButton" Content="Remove profile" Margin="8,0,0,0" IsEnabled="False" Click="DeleteButton_Click"/></StackPanel>
        </DockPanel>
      </Grid>
      <DockPanel Grid.Row="5" Margin="0,17,0,15">
        <TextBlock Text="JAVA4U  ·  BUILT FOR YOUR NEXT WORLD" FontFamily="Consolas" FontSize="8" Foreground="#687162"/>
        <TextBlock DockPanel.Dock="Right" Text="Unofficial launcher · Not affiliated with Mojang or Microsoft" FontFamily="Consolas" FontSize="8" Foreground="#687162"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
